{
  "theme": "devops",
  "name": "DevOps",
  "role": "Build, CI ve Pages deploy altyapısını izler: workflow, script ve araç zinciri; uygulama koduna dokunmaz.",
  "model": "sonnet",
  "maxTurns": 20,
  "maxChildren": 6,
  "childGates": false,
  "allowedTools": [
    "Read",
    "Edit",
    "Write",
    "Glob",
    "Grep",
    "Bash(pnpm typecheck*)",
    "Bash(pnpm lint*)",
    "Bash(pnpm test*)",
    "Bash(pnpm vitest*)",
    "Bash(git status*)",
    "Bash(git diff*)",
    "Bash(git log*)",
    "Bash(ls*)",
    "Bash(pnpm shots*)"
  ],
  "addDirs": [".github", "scripts"],
  "owner": "hq",
  "agents": ["default"]
}
